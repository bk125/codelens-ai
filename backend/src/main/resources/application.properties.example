spring.application.name=ai-code-reviewer
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/code_reviewer_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

ollama.api.url=https://ollama.com/v1/chat/completions
ollama.api.key=YOUR_OLLAMA_API_KEY
ollama.api.model=gemma3:12b

migration.throttle.delay-ms=1500

app.cors.allowed-origins=http://localhost:4200
app.jwt.secret=YOUR_BASE64_JWT_SECRET
app.jwt.expiration=86400000

logging.level.com.codereviewer=INFO

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_GMAIL_ADDRESS
spring.mail.password=YOUR_GMAIL_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

github.oauth.client-id=YOUR_GITHUB_CLIENT_ID
github.oauth.client-secret=YOUR_GITHUB_CLIENT_SECRET
github.oauth.redirect-uri=http://localhost:8080/api/v1/github/callback